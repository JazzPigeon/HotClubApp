<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  SUPABASE_URL: use Dashboard → Settings → API → "Project URL" exactly, e.g. https://abcd1234.supabase.co
  Do not paste REST or Auth endpoint URLs (no /rest/v1 or /auth/v1 on the end).
-->
<dict>
	<key>SUPABASE_URL</key>
	<string>https://YOUR_PROJECT_REF.supabase.co</string>
	<key>SUPABASE_ANON_KEY</key>
	<string>YOUR_SUPABASE_ANON_KEY</string>
</dict>
</plist>
